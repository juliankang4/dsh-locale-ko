{
  "name": "dsh-locale-ko",
  "version": "0.1.0",
  "description": "Korean (한국어) language pack for the DeepSeek Harness Web UI",
  "type": "module",
  "license": "MIT",
  "repository": "github:juliankang4/dsh-locale-ko",
  "keywords": ["dsh-plugin", "dsh", "deepseek-harness", "locale", "i18n", "korean"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "THIRD_PARTY_NOTICES.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  }
}
